FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements-teacher.txt ./
RUN pip install --no-cache-dir -r requirements-teacher.txt
COPY teacher-frontend/ teacher-frontend/

CMD ["sh", "-c", "streamlit run teacher-frontend/teacher_app.py --server.address 0.0.0.0 --server.port ${PORT:-8503} --server.headless true"]
