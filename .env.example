# LLM (OpenAI-compatible endpoint)
# Note: the old yunwu.ai host was retired; accounts and keys moved to
# api.openlux.ai, so a key issued on the old site returns 403 / invalid token.
LLM_BASE_URL=https://api.openlux.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
QUESTION_REVIEW_ENABLED=true
TUTOR_REVIEW_ENABLED=true

# Shared persistence (Railway PostgreSQL injects this automatically when linked)
DATABASE_URL=postgresql://user:password@host:5432/database

# Teacher service reads the API over Railway's private network.
BACKEND_URL=http://backend.railway.internal:8000
STUDENT_APP_URL=https://your-student-service.up.railway.app

# Build-time URL used by the Vite student service's Teacher button.
VITE_TEACHER_DASHBOARD_URL=https://your-teacher-service.up.railway.app

# Local textbook retrieval
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_DIR=data/models/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=4500
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mit_calculus

# Local Vite proxy target (do not set this to Railway in local development).
VITE_BACKEND_URL=http://127.0.0.1:8000
