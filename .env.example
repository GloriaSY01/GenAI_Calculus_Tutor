# LLM (OpenAI-compatible endpoint)
# Note: the old yunwu.ai host was retired; accounts and keys moved to
# api.openlux.ai, so a key issued on the old site returns 403 / invalid token.
LLM_BASE_URL=https://api.openlux.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
QUESTION_REVIEW_ENABLED=true
TUTOR_REVIEW_ENABLED=true

# Leave empty for local JSON storage. For Railway, use the linked PostgreSQL URL.
DATABASE_URL=

# Local defaults. Override with your service URLs when deploying to Railway.
BACKEND_URL=http://127.0.0.1:8000
STUDENT_APP_URL=http://127.0.0.1:5173

# Build-time URL used by the Vite student service's Teacher button.
VITE_TEACHER_DASHBOARD_URL=http://127.0.0.1:8503

# Local textbook retrieval
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_DIR=data/models/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=4500
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mit_calculus

# Local Vite proxy target (do not set this to Railway in local development).
VITE_BACKEND_URL=http://127.0.0.1:8000
