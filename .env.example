# LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=https://yunwu.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Local textbook retrieval
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_DIR=data/models/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=4500
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mit_calculus

# Backend URL used by the Streamlit frontend
BACKEND_URL=http://localhost:8000
